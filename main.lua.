local function clearContent()
    for _, child in ipairs(content:GetChildren()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

local function label(text, color)
    return create("TextLabel", {
        Size = UDim2.new(1, -4, 0, 32),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or WHITE,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Font = Enum.Font.GothamMedium,
        TextSize = 13
    }, content)
end

local function action(text, callback)
    local b = create("TextButton", {
        Size = UDim2.new(1, -4, 0, 38),
        BackgroundColor3 = Color3.fromRGB(48, 22, 31),
        Text = text,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        AutoButtonColor = false
    }, content)
    round(b, 6)
    stroke(b, RED)
    b.Activated:Connect(callback)
    return b
end

local currentTab = "HOME"
local function showTab(name)
    currentTab = name
    clearContent()

    if name == "HOME" then
        label("WELCOME, " .. player.Name, RED)
        label("NIKO X DOMINAI LIMITED EDITION")
        label("UI STATUS: ONLINE", Color3.fromRGB(100, 255, 170))
        label("Pilih tab di atas untuk melihat fitur.")
    elseif name == "MOVEMENT" then
        label("MOVEMENT • GAME DEVELOPMENT")
        label("Fitur gameplay perlu diimplementasikan di game milikmu.")
        action("CHECK CHARACTER", function()
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            label(hum and ("Humanoid ditemukan • Speed: " ..
                tostring(hum.WalkSpeed)) or "Character belum tersedia", RED)
        end)
        action("RESET CHARACTER", function()
            local hum = player.Character and
                player.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
        end)
    elseif name == "VISUAL" then
        label("VISUAL DEBUG")
        label("Gunakan visualisasi hitbox dan penanda NPC di project sendiri.")
        action("SHOW DEBUG INFO", function()
            label("Player: " .. player.Name, RED)
            label("Character: " ..
                (player.Character and player.Character.Name or "Belum spawn"))
        end)
    elseif name == "PLAYER" then
        label("PLAYER INFORMATION")
        for _, p in ipairs(Players:GetPlayers()) do
            label(p.Name .. (p == player and "  •  YOU" or ""))
        end
        action("REFRESH PLAYER LIST", function()
            showTab("PLAYER")
        end)
    elseif name == "ANIMATION" then
        label("ANIMATION TAB")
        label("Animasi karakter memerlukan asset dan izin yang sesuai.")
        action("REFRESH CHARACTER STATUS", function()
            local char = player.Character
            label(char and "Character tersedia" or "Character belum spawn", RED)
        end)
    elseif name == "AUTOMATION" then
        label("AUTOMATION • TEST ENVIRONMENT")
        label("Auto-farm hanya untuk mekanik game milik sendiri.")
        label("Hub ini tidak mengirim aksi otomatis ke game publik.")
    elseif name == "SETTINGS" then
        label("SETTINGS")
        action("HIDE MENU", function()
            main.Visible = false
        end)
        action("CLOSE UI", function()
            gui:Destroy()
        end)
    end
end

